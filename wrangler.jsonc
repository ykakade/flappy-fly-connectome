{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yash-projects",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": ".deploy",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "projects.yashkakade.com",
      "custom_domain": true
    },
    {
      "pattern": "project.yashkakade.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
